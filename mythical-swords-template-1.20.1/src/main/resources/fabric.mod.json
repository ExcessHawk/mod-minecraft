{
	"schemaVersion": 1,
	"id": "mythicalswords",
	"version": "${version}",
	"name": "Mythical Swords Mod",
	"description": "Adds mythical weapons from global mythologies with special abilities and progression",
	"authors": [
		"ExcessHawk"
	],
	"contact": {
		"homepage": "https://veloce-ts.com/",
		"sources": "https://github.com/ExcessHawk/mythical-swords-mod"
	},
	"license": "MIT",
	"icon": "assets/mythical-swords/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mythicalswords.MythicalSwords"
		],
		"client": [
			"com.mythicalswords.MythicalSwordsClient"
		],
		"fabric-datagen": [
			"com.mythicalswords.MythicalSwordsDataGenerator"
		],
		"rei_client": [
			"com.mythicalswords.compat.rei.MythicalSwordsREIPlugin"
		]
	},
	"mixins": [
		"mythical-swords.mixins.json",
		{
			"config": "mythical-swords.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"geckolib": ">=4.4"
	},
	"suggests": {
		"roughlyenoughitems": "*"
	}
}